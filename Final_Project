//Global Scope Functions --> for later use in logic control
// Stop robot function to stop both motors
void stopRobot() {
  motor_left.write(90);
  motor_right.write(90);
}

//turn around function, moves motors in opposite directions to turn the robot around in place, 500 ms delay to ensure motor innstruction execution

void turnAround(){
  motor_left.write(70);
  motor_right.write(110);
  delay(1500);
  motor_left.write(90);
  motor_right.write(90);
  delay(20);

}

void turnLeft(){
  motor_left.write(70);
  motor_right.write(110);
  delay(720);
  motor_left.write(90);
  motor_right.write(90);
  delay(20);
}

void turnRight(){
  motor_left.write(110);
  motor_right.write(70);
  delay(720);
  motor_left.write(90);
  motor_right.write(90);
  delay(20);
}

void leftCorrection(){
  motor_left.write(120);
  motor_right.write(123);
  delay(20);
}

void rightCorrection(){
  motor_left.write(123);
  motor_right.write(120);
  delay(20);
}

float wrapAngle(float angle_deg){
  while(angle_deg > 180){
    angle_deg -= 360;
  }
  while(angle_deg < -180){
    angle_deg += 360;
  }
  return angle_deg;
}

void finishLoop(unsigned long stamp){
  mqtt_clean();
  while (millis() - stamp < 100){delay(5);} 
}
// Intializing setup for the robot
void setup() {
  Serial.begin(115200);
  motor_left.attach(D3);
  motor_right.attach(D6);
  motor_left.write(90);
  motor_right.write(90);
  Wire.begin();
  wifi_mqtt_init();
  mqtt_clean();
  display.init();
  display.flipScreenVertically();
  delay(TARGET_HOLD_TIME);

}

void loop() {
  unsigned long stamp = millis();
  mqtt_rebound();
  client.loop();

//Reading data from ultrasonic sensors
  int dist_cm_front = ultrasonic_front.read(CM);
  int dist_cm_right = ultrasonic_right.read(CM);
  int dist_cm_left = ultrasonic_left.read(CM);
  delay(20);

//Control Logic

//End route --> all targets hit
 if(mission_complete == true || target_index >= NUM_TARGETS){
    mission_complete = true;
    stopRobot();
    finishLoop(stamp);
    return;
 }

//Checking current target
int target_x = x_targets[target_index];
int target_y = y_targets[target_index];

//Distance equations
float dx = target_x - x_robot;
float dy = target_y - y_robot;
dist_to_target = sqrt(dx * dx + dy * dy);

//When target reached
if(dist_to_target <= TARGET_REACHED_RADIUS){
  stopRobot();
  delay(TARGET_HOLD_TIME);
  target_index++;
  finishLoop(stamp);
  return;
}

//Obstacle Avoidance Logic
if (dist_cm_front <= FRONT_STOP_DISTANCE_CM){
  stopRobot();
  delay(10);
  if(dist_cm_left > LEFT_STOP_DISTANCE_CM && dist_cm_right <= RIGHT_STOP_DISTANCE_CM){
    turnLeft();
  }
  else if(dist_cm_right > RIGHT_STOP_DISTANCE_CM && dist_cm_left <= LEFT_STOP_DISTANCE_CM){
    turnRight();
  }
  else if(dist_cm_left > dist_cm_right + 2){
    turnLeft();
  }
  else if(dist_cm_right > dist_cm_left + 2){
    turnRight();
  }
  else{
    turnAround();
  }
}
else if(dist_cm_left <= LEFT_STOP_DISTANCE_CM && dist_cm_right > RIGHT_STOP_DISTANCE_CM){
  rightCorrection();
}
else if(dist_cm_right <= RIGHT_STOP_DISTANCE_CM && dist_cm_left > LEFT_STOP_DISTANCE_CM){
  leftCorrection();
}
else if(dist_cm_left <= LEFT_STOP_DISTANCE_CM && dist_cm_right <= RIGHT_STOP_DISTANCE_CM){
  if(dist_cm_left > dist_cm_right){
    turnLeft();
  }
  else{
    turnRight();
  }
}
else{
  //Calculating angle error
  float target_angle = atan2(dy,dx) * 180.0/PI;
  angle_error = wrapAngle(target_angle - z_ang_robot);

  //Navigation with angle measurements
  if (angle_error > 20){
    leftCorrection();
  }
  else if(angle_error < -20){
    rightCorrection();
  }
  else{
    motor_left.write(121);
    motor_right.write(120);
    delay(20);
  }
}
// Pushing headers to OLED Display
  display.setFont(ArialMT_Plain_16);
  display.drawString(0, 0, "Front: ");
  display.drawString(0, 18, "Right: ");
  display.drawString(0, 36, "Left: ");

 
// Publishing sensor data to OLED Display
  display.drawString(90, 0, String(dist_cm_front));
  display.drawString(90, 18, String(dist_cm_right));
  display.drawString(90, 36, String(dist_cm_left));

  display.display();
  delay(10);
  display.clear();

  mqtt_clean();
  while (millis() - stamp < 100){delay(5);}   //Sticks into an empty loop until it has been more than 100ms.

}
