//Constant Variables
const int FRONT_STOP_DISTANCE_CM = 18;
const int RIGHT_STOP_DISTANCE_CM = 9;
const int LEFT_STOP_DISTANCE_CM = 9;
const int TARGET_REACHED_RADIUS = 100; // 10cm = 100mm
const int TARGET_HOLD_TIME = 2000;


//Target List --> need to replace with actual values before competition
const int x_targets[] = {1450, 200, 200, 650}; //Sample x-coordinates for targets
const int y_targets[] = { 150, 600, 150, 150}; //Sample y-coordinates for targets
const int NUM_TARGETS = sizeof(x_targets) / sizeof(x_targets[0]); //number of targets in array --> total data bytes/ 1 int byes = # on ints in array

int target_index = 0;
float x_robot;
float y_robot;
float z_ang_robot;
float dist_to_target = 0;
float angle_error = 0;

bool mission_complete = false;

